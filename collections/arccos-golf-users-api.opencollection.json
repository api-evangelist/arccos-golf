{
  "opencollection": "1.0.0",
  "info": {
    "name": "Arccos On-Course Data Users API",
    "version": "1"
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get One User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v5/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://signin.arccosgolf.com/login",
              "accessTokenUrl": "https://api.arccosgolf.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get details for one user"
        }
      ]
    }
  ],
  "bundled": true
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "Arccos On-Course Data Courses API",
    "version": "1"
  },
  "items": [
    {
      "info": {
        "name": "Courses",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Courses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v5/courses",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "maximum number of results to get"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "number of results to get per request"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Search by partial course name"
              }
            ]
          },
          "docs": "Search Courses"
        },
        {
          "info": {
            "name": "Get One Course",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v5/courses/:courseId",
            "params": [
              {
                "name": "courseId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get One Course"
        },
        {
          "info": {
            "name": "Get One Course Version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v5/courses/:courseId/versions/:courseVersion",
            "params": [
              {
                "name": "courseId",
                "value": "",
                "type": "path"
              },
              {
                "name": "courseVersion",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get One Course Version"
        }
      ]
    }
  ],
  "bundled": true
}
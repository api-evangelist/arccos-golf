              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "number of results to get per request"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Search by partial course name"
              }
            ]
          },
          "docs": "Search Courses"
        },
        {
          "info": {
            "name": "Get One Course",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v5/courses/:courseId",
            "params": [
